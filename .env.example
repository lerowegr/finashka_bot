# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Строка подключения к БД. Для PostgreSQL: postgresql+asyncpg://user:pass@host/dbname
DB_URL=sqlite+aiosqlite:///data/bot.db

# Максимум запросов в секунду к tabiturient.ru
SCRAPE_RPS=1.0

# Чат для сводок ETL и алертов (опционально)
ADMIN_CHAT_ID=

LOG_LEVEL=INFO
